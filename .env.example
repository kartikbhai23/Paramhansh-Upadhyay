# ---------------------------------------------------------------------------
# Example environment file. Copy this to ".env" and fill in real values.
#   cp .env.example .env      (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# The real ".env" file is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# Node environment: "development" or "production".
# In "production", session cookies are marked Secure (HTTPS-only).
NODE_ENV=development

# Port the server listens on.
PORT=3000

# Secret used to sign session cookies. MUST be long and random.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Initial administrator account.
# Used to create server/data/admin.json on first startup (or via `npm run seed`).
# After first login, change these from the admin panel; updating them here later
# has no effect unless you re-run `npm run seed -- --force`.
ADMIN_EMAIL=admin@safarlegaltrust.org
ADMIN_PASSWORD=ChangeMe!2026

# How long a login session stays valid, in minutes (idle timeout, rolling).
SESSION_TTL_MINUTES=120
